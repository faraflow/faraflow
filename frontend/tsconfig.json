{
    "extends": "./.svelte-kit/tsconfig.json",
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowJs": true,
        "checkJs": true,
        "strict": false,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "noErrorTruncation": true
    },
    "include": ["src/**/*", "src/**/*.svelte"],
    "exclude": ["node_modules"]
}
